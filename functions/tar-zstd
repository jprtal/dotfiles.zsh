if [ $# -eq 0 ]; then
    echo "Usage: tar-zstd [1-19] <output> <input>"
    echo "Use '`kill -USR1 <pid>` or `pkill -USR1 tar`' to print statistics."
    return 1
fi

local re="^([1-9]|1[0-9]|2[0-2])$"
if ! [[ $1 =~ $re ]] ; then
   echo "Not a valid compression level [1-19]"
   return 2
fi

if [[ "$2" != *".tar.zst" ]]; then
    echo "Need to specify a valid output file '<filename>.tar.zst'"
    return 3
fi

# e.g., 'xz -T0 -6'
tar --totals=USR1 --create --preserve-permissions --use-compress-program "zstd -T0 -${1} | pv" -f "$2" "${@:3}"
