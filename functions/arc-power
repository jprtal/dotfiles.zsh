local DEVICE=$(lspci | awk '/VGA.*DG2/' | cut -d' ' -f 1)
local ENERGY_PATH=$(find /sys/bus/pci/devices/0000:$DEVICE/hwmon/hwmon1/ -name "energy*_input" -print -quit)

if [[ ! -f "$ENERGY_PATH" ]]; then
    echo "Invalid graphics energy path"
    return 1
fi

local seconds=1
if [ $# -eq 1 ]; then
    seconds="$1"
fi

local first_measure="$(<"$ENERGY_PATH")"
sleep "$seconds";
local second_measure="$(<"$ENERGY_PATH")"

local microjoules_second=$((second_measure - first_measure))
# local watts=$((microjoules_second / 1000000))
local watts=$(echo "scale=2; $microjoules_second / 1000000" | bc)
echo "$watts W"
echo "in $seconds seconds"
